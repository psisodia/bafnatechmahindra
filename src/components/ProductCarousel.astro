---
import { productInquiryMessage, whatsappUrl, type Product } from "../data/products";

type Props = {
  products: Product[];
  ariaLabel?: string;
};

const { products, ariaLabel = "Product carousel" } = Astro.props;
---

<section class="carousel reveal" aria-label={ariaLabel} data-carousel>
  <div class="carousel-track" data-carousel-track>
    {products.map((product) => (
      <article class="carousel-slide">
        <div class="carousel-image">
          <img src={product.image} alt={product.name} loading="lazy" />
        </div>
        <div class="carousel-copy">
          <span class="category-label">{product.categoryName}</span>
          <h3>{product.name}</h3>
          <p>{product.description}</p>
          <div class="button-row">
            <a class="btn" href={`/products/${product.categorySlug}/${product.slug}/`}>
              View Product
            </a>
            <a
              class="btn whatsapp"
              href={whatsappUrl(productInquiryMessage(product))}
              target="_blank"
              rel="noreferrer"
            >
              Inquire on WhatsApp
            </a>
          </div>
        </div>
      </article>
    ))}
  </div>
  <div class="carousel-controls">
    <button class="icon-btn" type="button" data-carousel-prev aria-label="Previous product">
      <svg aria-hidden="true" viewBox="0 0 24 24">
        <path d="m15 18-6-6 6-6"></path>
      </svg>
    </button>
    <button class="icon-btn" type="button" data-carousel-next aria-label="Next product">
      <svg aria-hidden="true" viewBox="0 0 24 24">
        <path d="m9 6 6 6-6 6"></path>
      </svg>
    </button>
  </div>
</section>

<script>
  document.querySelectorAll("[data-carousel]").forEach((carousel) => {
    if (carousel.dataset.carouselReady === "true") return;
    carousel.dataset.carouselReady = "true";

    const track = carousel.querySelector("[data-carousel-track]");
    const slides = Array.from(carousel.querySelectorAll(".carousel-slide"));
    const prev = carousel.querySelector("[data-carousel-prev]");
    const next = carousel.querySelector("[data-carousel-next]");
    let index = 0;
    let lastTick = 0;
    let frameId;
    const interval = 2500;

    function updateCarousel() {
      if (!track) return;
      track.style.transform = `translate3d(-${index * 100}%, 0, 0)`;
    }

    function go(direction) {
      if (slides.length < 2) return;
      index = (index + direction + slides.length) % slides.length;
      updateCarousel();
      lastTick = 0;
    }

    function tick(now) {
      if (document.hidden) {
        lastTick = now;
      } else if (!lastTick) {
        lastTick = now;
      } else if (now - lastTick >= interval) {
        go(1);
        lastTick = now;
      }
      frameId = window.requestAnimationFrame(tick);
    }

    prev?.addEventListener("click", () => go(-1));
    next?.addEventListener("click", () => go(1));
    if (slides.length > 1 && !frameId) {
      frameId = window.requestAnimationFrame(tick);
    }
  });
</script>
